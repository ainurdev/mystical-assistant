# Secrets — .env holds the Telegram bot token
.env

# Mini App uploads (screenshots sent from the phone)
.bridge_uploads/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
/dist/          # Python build output at the repo root only — NOT the web bundles

# Mini App frontend build artifacts (dist/ is committed — ships prebuilt)
bridge/miniapp/web/node_modules/
bridge/miniapp/web/.vite/
*.tsbuildinfo

# Dashboard frontend build artifacts (dist/ is NOT committed — run `npm run build`)
bridge/dashboard/web/node_modules/
bridge/dashboard/web/.vite/
bridge/dashboard/web/dist/

# Selector plugin package (dist/agent.global.js is committed intentionally)
tools/selector-plugin/node_modules/
tools/selector-plugin/.vite/

# Vite cache (when vite is run from the repo root)
/.vite/

# Session store (default lives in $HOME; ignore any local copy)
.bridge_state/

# graphify knowledge-graph output (regenerable, ~20MB incl. cache)
graphify-out/
