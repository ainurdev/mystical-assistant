# Secrets — .env holds the Telegram bot token
.env

# Mini App uploads (screenshots sent from the phone)
.bridge_uploads/

# Node deps, anywhere — a scoped rule once let tools/selector-plugin commit 139MB
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Build output anywhere — no dist/ is committed; setup.sh (or `mystical build`)
# builds the dashboard, Mini App and landing page.
# The glob, not a bare dist/: a plain `dist/` rule let dist.bak/ and dist.prev-*/
# snapshots get committed once (10MB of bundles) before anyone noticed.
dist*/
.vite/
*.tsbuildinfo

# Session store (default lives in $HOME; ignore any local copy)
.bridge_state/

# graphify knowledge-graph output (regenerable, ~20MB incl. cache)
graphify-out/
