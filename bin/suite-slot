#!/usr/bin/env python3
"""One full test suite at a time on this machine. `suite-slot <command> [args...]` waits while
another suite holds the slot, saying what it waits for, then becomes the command (exec), so the
slot is held while the command runs and freed when it exits, even when it is killed.

Ticket and merge sessions put it in front of their full suite (bridge/tickets.py): over 109
tickets (2026-11-27), suites that overlapped two or more other tickets' tests ran 2-2.5x slower
and failed 53% of the time, against 24% alone, and failures drove the re-runs. A flock, not a
lock directory, so a dead holder can't leave a stale lock. Imports none of the bridge; the lock
sits beside the bridge DB, so a test's pinned BRIDGE_DB gets a slot of its own.

usage: bin/suite-slot <command> [args...]      as: bin/suite-slot npm test"""
import fcntl
import os
import sys
import time

DB = os.path.expanduser(os.environ.get("BRIDGE_DB", "~/.bridge_state/bridge.db"))


def main(argv: list) -> None:
    if not argv:
        sys.exit(__doc__.rsplit("\n\n", 1)[-1])
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    fd = os.open(os.path.join(os.path.dirname(DB), "suite.lock"), os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        holder = os.pread(fd, 400, 0).decode(errors="replace").strip() or "another suite"
        print(f"suite-slot: waiting for {holder}", file=sys.stderr, flush=True)
        # shortcut: flock wakes waiters in no set order, so one can be passed over; queue them by arrival if a wait ever spans several suites
        fcntl.flock(fd, fcntl.LOCK_EX)
    os.ftruncate(fd, 0)
    os.pwrite(fd, f"`{' '.join(argv)[:160]}` in {os.getcwd()}, since {time.strftime('%H:%M')}".encode(), 0)
    os.set_inheritable(fd, True)   # the command holds the lock from here
    try:
        os.execvp(argv[0], argv)
    except OSError as e:
        sys.exit(f"suite-slot: {argv[0]}: {e.strerror}")


if __name__ == "__main__":
    main(sys.argv[1:])
