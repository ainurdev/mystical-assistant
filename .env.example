# ── mystical-assistant configuration ──────────────────────────────────────
# ./setup.sh writes your real .env for you; edit by hand only for advanced
# options. .env is git-ignored (it holds your bot token). Keep it chmod 600.
#
# You mostly shouldn't need this file any more: the dashboard's SETTINGS →
# SYSTEM tab edits every option below, and what you set there wins over what
# you set here. This file stays the floor those overrides fall back to, so a
# value is never lost — RESET TO .ENV on any row returns to what is written
# here. The model-spending extras have their own switches on the AI tab.

# ── required ───────────────────────────────────────────────────────────────
# Root folder the project browser starts in (the parent of your repos).
BASE_PATH="$HOME/projects"
# Telegram bot token from @BotFather (https://t.me/BotFather → /newbot).
# Empty = dashboard-only install: the bot and Mini App stay off and the bridge
# serves the desktop dashboard alone.
TELEGRAM_BOT_TOKEN=""
# Your Telegram numeric chat id(s), comma-separated. setup.sh captures this;
# leave empty for first-run discovery mode.
ALLOWED_CHAT_IDS=""

# ── autonomy ───────────────────────────────────────────────────────────────
# setup.sh asks for these on first run rather than defaulting you into anything.
# Plain-text bot path permission posture:
#   --permission-mode acceptEdits   (limited)
#   --dangerously-skip-permissions  (full autonomy — only with ALLOWED_CHAT_IDS locked)
EXTRA_CLAUDE_ARGS="--permission-mode acceptEdits"
# Sessions started from the dashboard / Mini App carry this mode, so it decides
# whether Claude runs commands without asking. "bypassPermissions" is full
# autonomy: anything that can inject a prompt then runs commands as you.
NEW_SESSION_PERMISSION_MODE="acceptEdits"

# ── dashboard (localhost only) ─────────────────────────────────────────────
# Anti-CSRF token for the desktop dashboard. Empty disables the ?token= gate
# (localhost convenience). setup.sh generates a secret here.
DASH_TOKEN=""

# ── Mini App (optional; needs a tunnel client) ─────────────────────────────
# 0 disables the Telegram Mini App panel so no tunnel client is required.
MINIAPP_ENABLE="1"

# ── named preview tunnel (optional) ────────────────────────────────────────
# Leave empty for throwaway public links on /preview. For a stable URL,
# provision a named tunnel and set these four.
PREVIEW_HOSTNAME=""
TUNNEL_NAME=""
TUNNEL_ID=""
TUNNEL_CREDENTIALS_FILE=""

# ── rivendell PR review plugin (optional) ──────────────────────────────────
# Connects to a rivendell-api instance and turns its "Request review" and
# "Implement using AI" buttons into autonomous Claude runs. Off by default;
# needs an API token minted in Rivendell (Profile -> Tokens) with the LLM
# capability.
#
# One bridge can now serve SEVERAL Rivendells (production, local, staging) — add
# and edit them from the dashboard's SETTINGS -> PLUGINS tab, which stores each
# beside the session store. The variables below are only a MIGRATION SEED: on
# first run with no stored instances, they become a single instance named
# "production". Edit it (or add more) from the PLUGINS tab afterwards; changing
# these afterwards does nothing.
RIVENDELL_ENABLE="0"
# Base URL of the rivendell-api instance, e.g. http://localhost:3001
RIVENDELL_API_URL=""
# Bearer token (rvd_...). Also stored as your personal secret in Rivendell.
RIVENDELL_TOKEN=""
# Derived from RIVENDELL_API_URL (+ /agent) unless set explicitly.
RIVENDELL_WS_URL=""
# Model for review sessions (passed to `claude --model`).
RIVENDELL_MODEL="opus"
# Where review sessions run; empty falls back to BASE_PATH.
RIVENDELL_WORKDIR=""
# Wall-clock cap (seconds) for one review before it is failed.
RIVENDELL_REVIEW_TIMEOUT="3600"
