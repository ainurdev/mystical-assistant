#!/usr/bin/env python3
"""A Claude Code commit message is one line of at most 72 characters: the user's git rules (one
line means no body, so no Co-Authored-By or other trailer). As prose alone the rules lost: 36
commits in 60 days carried a Claude attribution line. Only in Claude Code's shells (CLAUDECODE=1),
like pre-commit. A message git wrote itself passes: a merge, a revert, and a cherry-pick or rebase
replaying an older commit."""
import os
import subprocess
import sys

if os.environ.get("CLAUDECODE") != "1":
    sys.exit(0)
git_dir = subprocess.run(["git", "rev-parse", "--git-dir"], capture_output=True, text=True).stdout.strip()
if any(os.path.exists(os.path.join(git_dir, n)) for n in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "rebase-merge", "rebase-apply")):
    sys.exit(0)
with open(sys.argv[1], encoding="utf-8", errors="replace") as f:
    text = f.read().split("# ------------------------ >8 ------------------------")[0]   # `git commit -v` puts the diff below this
lines = [line.rstrip() for line in text.splitlines() if not line.startswith("#")]
while lines and not lines[-1]:
    lines.pop()
if not lines or any(line.startswith("This reverts commit ") for line in lines):
    sys.exit(0)
if len(lines[0]) > 72:
    sys.exit(f"commit-msg: the subject is {len(lines[0])} characters. Write it in 72 or fewer.")
if len(lines) > 1:
    sys.exit("commit-msg: the message is one line. Leave out the body and any trailer (Co-Authored-By too).")
